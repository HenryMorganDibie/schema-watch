# --- packages/server (cloud backend) ---
# Port 5433 matches docker-compose.yml, which avoids clashing with a
# PostgreSQL already installed on the host.
DATABASE_URL="postgresql://schema_watch:schema_watch@localhost:5433/schema_watch?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
APP_URL="http://localhost:5173"

# --- Payments (BOTH are optional; the server boots and the free tier works
# --- with neither set. Configure whichever you can actually collect with.)

# Stripe: cards/USD internationally. Not available to Nigerian businesses.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_TEAM=""

# Flutterwave: NGN and other African currencies, cards, bank transfer, USSD.
# WEBHOOK_HASH is the "Secret hash" you set in the Flutterwave dashboard;
# the webhook is rejected unless it matches.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
FLUTTERWAVE_PLAN_ID_PRO=""
FLUTTERWAVE_PLAN_ID_TEAM=""

# --- packages/agent (local proxy) ---
# Set these via schema-watch.config.json instead in normal use; env vars are
# fallbacks for CI / non-interactive runs.
SCHEMA_WATCH_TARGET="http://localhost:3001"
SCHEMA_WATCH_PROXY_PORT=4560
SCHEMA_WATCH_API_PORT=4561
SCHEMA_WATCH_SYNC_API_KEY=""
SCHEMA_WATCH_SYNC_PROJECT_ID=""
SCHEMA_WATCH_CLOUD_URL="http://localhost:4000"
