generator client {
  provider = "prisma-client-js"
  // "native" covers local development on any OS. The rhel target is the engine
  // Vercel's Lambda runtime needs; without it the deployed function starts and
  // then fails at the first query with a missing-query-engine error.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connections go through a pooler (Supabase pgbouncer on :6543).
  // Serverless functions open a connection per invocation, which exhausts a
  // direct Postgres connection limit almost immediately.
  url = env("DATABASE_URL")
  // Migrations need a direct connection (:5432); pgbouncer cannot run DDL in
  // transaction mode. Falls back to DATABASE_URL when unset, so a plain local
  // Postgres still works with a single variable.
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum BodyTarget {
  REQUEST
  RESPONSE
}

enum ChangeSeverity {
  BREAKING
  WARNING
  INFO
}

enum IntegrationType {
  SLACK
  DISCORD
  GITHUB
}

enum BillingProvider {
  STRIPE
  FLUTTERWAVE
  // Paid by bank transfer and granted by hand. Recorded explicitly so a
  // manually upgraded team is never mistaken for one that paid a processor.
  MANUAL
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  name          String?
  emailVerified Boolean             @default(false)
  // Bumped on password reset. Every JWT carries the version it was signed
  // with, so raising this invalidates all existing sessions at once - the
  // only way to log out a stolen stateless token before it expires.
  tokenVersion  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   TeamMember[]
  tokens        VerificationToken[]
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Single-use, expiring tokens for email verification and password reset.
// Only the SHA-256 hash is stored: a leaked database backup then cannot be
// used to take over accounts, the same reasoning as ApiKey.keyHash.
model VerificationToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

model Team {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  plan                 Plan             @default(FREE)
  billingProvider      BillingProvider?
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?
  flutterwaveTxRef     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  members              TeamMember[]
  projects             Project[]
  apiKeys              ApiKey[]
}

model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  createdAt    DateTime      @default(now())
  endpoints    Endpoint[]
  integrations Integration[]

  @@unique([teamId, slug])
}

model Endpoint {
  id          String           @id @default(cuid())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  method      String
  pathPattern String
  createdAt   DateTime         @default(now())
  snapshots   SchemaSnapshot[]
  changes     ContractChange[]

  @@unique([projectId, method, pathPattern])
}

model SchemaSnapshot {
  id         String     @id @default(cuid())
  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String
  target     BodyTarget
  statusCode Int?
  schema     Json
  hash       String
  createdAt  DateTime   @default(now())

  @@index([endpointId, target, createdAt])
}

model ContractChange {
  id             String         @id @default(cuid())
  endpoint       Endpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId     String
  severity       ChangeSeverity
  target         BodyTarget
  summary        String
  changes        Json
  affectedFiles  Json           @default("[]")
  fromSnapshotId String?
  toSnapshotId   String?
  acknowledged   Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([endpointId, createdAt])
}

// Fixed-window counters for rate limiting. Kept in Postgres rather than in
// memory because the API runs as serverless functions: an in-process counter
// would reset on every cold start and never be shared between instances,
// which is exactly the case an attacker benefits from.
model RateLimit {
  id        String   @id @default(cuid())
  bucket    String
  windowEnd DateTime
  count     Int      @default(1)

  @@unique([bucket, windowEnd])
  @@index([windowEnd])
}

model Integration {
  id        String          @id @default(cuid())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  type      IntegrationType
  config    Json
  createdAt DateTime        @default(now())
}
