generator client {
  provider = "prisma-client-js"
  // "native" covers local development on any OS. The rhel target is the engine
  // Vercel's Lambda runtime needs; without it the deployed function starts and
  // then fails at the first query with a missing-query-engine error.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connections go through a pooler (Supabase pgbouncer on :6543).
  // Serverless functions open a connection per invocation, which exhausts a
  // direct Postgres connection limit almost immediately.
  url = env("DATABASE_URL")
  // Migrations need a direct connection (:5432); pgbouncer cannot run DDL in
  // transaction mode. Falls back to DATABASE_URL when unset, so a plain local
  // Postgres still works with a single variable.
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum BodyTarget {
  REQUEST
  RESPONSE
}

enum ChangeSeverity {
  BREAKING
  WARNING
  INFO
}

enum IntegrationType {
  SLACK
  DISCORD
  GITHUB
}

enum BillingProvider {
  STRIPE
  FLUTTERWAVE
  // Paid by bank transfer and granted by hand. Recorded explicitly so a
  // manually upgraded team is never mistaken for one that paid a processor.
  MANUAL
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  name          String?
  emailVerified Boolean             @default(false)
  // Bumped on password reset. Every JWT carries the version it was signed
  // with, so raising this invalidates all existing sessions at once - the
  // only way to log out a stolen stateless token before it expires.
  tokenVersion  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   TeamMember[]
  tokens        VerificationToken[]
  sessions      Session[]
}

// An interactive browser session, refreshable and revocable.
//
// Access tokens stay stateless and short-lived; this row is what makes
// logout, "sign out everywhere", and reuse detection possible at all. Only
// the SHA-256 hash of the refresh token is stored, so a leaked backup cannot
// be replayed - the same reasoning as ApiKey and VerificationToken.
//
// Machine credentials (ApiKey) are deliberately NOT modelled here: a CI job
// and a browser tab should never share a credential type.
model Session {
  id               String    @id @default(cuid())
  refreshTokenHash String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  // Rotation: each refresh mints a successor. Presenting an already-rotated
  // token means it leaked, so the whole family is revoked.
  rotatedToId      String?   @unique
  revokedAt        DateTime?
  // Why it ended, for the security event log and the sessions UI.
  revokedReason    String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  // Coarse client hint for a "your sessions" list. Never an IP address.
  userAgentLabel   String?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Single-use, expiring tokens for email verification and password reset.
// Only the SHA-256 hash is stored: a leaked database backup then cannot be
// used to take over accounts, the same reasoning as ApiKey.keyHash.
model VerificationToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

model Team {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  plan                 Plan             @default(FREE)
  billingProvider      BillingProvider?
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?
  flutterwaveTxRef     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  members              TeamMember[]
  projects             Project[]
  apiKeys              ApiKey[]
  telemetryInstallations TelemetryInstallation[]
}

model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  createdAt    DateTime      @default(now())
  endpoints    Endpoint[]
  integrations Integration[]

  @@unique([teamId, slug])
}

model Endpoint {
  id          String           @id @default(cuid())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  method      String
  pathPattern String
  createdAt   DateTime         @default(now())
  snapshots   SchemaSnapshot[]
  changes     ContractChange[]

  @@unique([projectId, method, pathPattern])
}

model SchemaSnapshot {
  id         String     @id @default(cuid())
  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String
  target     BodyTarget
  statusCode Int?
  schema     Json
  hash       String
  createdAt  DateTime   @default(now())

  @@index([endpointId, target, createdAt])
}

model ContractChange {
  id             String         @id @default(cuid())
  endpoint       Endpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId     String
  severity       ChangeSeverity
  target         BodyTarget
  summary        String
  changes        Json
  affectedFiles  Json           @default("[]")
  fromSnapshotId String?
  toSnapshotId   String?
  acknowledged   Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([endpointId, createdAt])
}

// Product telemetry for questions the other tables cannot answer: anonymous
// website engagement, and server-side actions that leave no row of their own
// (a login, a CI check). Anything already recorded - users, projects,
// snapshots, contract changes - is counted from its own table rather than
// duplicated here.
//
// Deliberately not stored: IP addresses, user agents, full referrer URLs
// (only the host), request payloads, source code, or anything from a
// customer's captured traffic.
model AnalyticsEvent {
  id                String   @id @default(cuid())
  eventName         String
  occurredAt        DateTime @default(now())
  anonymousVisitorId String?
  sessionId         String?
  userId            String?
  projectId         String?
  route             String?
  referrerHost      String?
  metadata          Json?

  @@index([eventName, occurredAt])
  @@index([occurredAt])
  @@index([userId])
  @@index([projectId])
  @@index([anonymousVisitorId])
}

// Fixed-window counters for rate limiting. Kept in Postgres rather than in
// memory because the API runs as serverless functions: an in-process counter
// would reset on every cold start and never be shared between instances,
// which is exactly the case an attacker benefits from.
model RateLimit {
  id        String   @id @default(cuid())
  bucket    String
  windowEnd DateTime
  count     Int      @default(1)

  @@unique([bucket, windowEnd])
  @@index([windowEnd])
}

enum DeliveryStatus {
  SUCCESS
  FAILED
}

model Integration {
  id        String          @id @default(cuid())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  type      IntegrationType
  config    Json
  enabled   Boolean         @default(true)
  // Only changes at or above this severity are delivered. Defaults to
  // BREAKING so a new webhook does not immediately become noise.
  minSeverity ChangeSeverity @default(BREAKING)
  // A webhook that has been deleted on the far end fails forever; after
  // enough consecutive failures it is disabled rather than retried on every
  // contract change.
  consecutiveFailures Int    @default(0)
  lastError      String?
  lastDeliveryAt DateTime?
  createdAt DateTime        @default(now())
  deliveries IntegrationDelivery[]
}

// One row per delivery attempt. Without this a failed notification is
// invisible: the user believes their team was alerted when nothing arrived.
model IntegrationDelivery {
  id            String         @id @default(cuid())
  integration   Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String
  status        DeliveryStatus
  statusCode    Int?
  summary       String
  error         String?
  createdAt     DateTime       @default(now())

  @@index([integrationId, createdAt])
}

/// One row per machine that has opted into telemetry. An installation is a
/// machine, not a person: the same developer's laptop and CI runner are two
/// rows unless they explicitly link both to a project.
model TelemetryInstallation {
  id             String   @id @default(cuid())
  installId      String   @unique
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  version        String?
  platform       String?
  nodeMajor      Int?
  /// "local" or "ci". Never conflate the two: a pipeline is not a person.
  environment    String   @default("local")
  /// Set only when the developer ran `telemetry link`. Null stays null: no
  /// attempt is ever made to infer that two anonymous machines are one person.
  /// Scoped to a team because that is what an API key belongs to, and for a
  /// solo developer a team is one person.
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  events         TelemetryEvent[]

  @@index([lastSeenAt])
  @@index([environment])
  @@index([teamId])
}

model TelemetryEvent {
  id             String   @id @default(cuid())
  installId      String
  installation   TelemetryInstallation @relation(fields: [installId], references: [installId], onDelete: Cascade)
  event          String
  occurredAt     DateTime @default(now())
  version        String?
  environment    String   @default("local")

  @@index([event, occurredAt])
  @@index([occurredAt])
  @@index([installId])
}
