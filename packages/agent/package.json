{
  "name": "schema-watch",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "schema-watch": "dist/cli.js"
  },
  "exports": {
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    }
  },
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle-dashboard.mjs",
    "prepack": "npm run build && npm run bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/ci/compare.test.ts src/context/brief.test.ts"
  },
  "dependencies": {
    "@schema-watch/core": "^0.1.0",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3"
  },
  "license": "Apache-2.0",
  "description": "Catch breaking API changes before your frontend breaks. Local proxy, live dashboard, and a CI contract gate.",
  "keywords": [
    "api",
    "contract",
    "schema",
    "breaking-change",
    "ci",
    "openapi",
    "developer-tools"
  ],
  "homepage": "https://github.com/HenryMorganDibie/schema-watch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryMorganDibie/schema-watch.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/HenryMorganDibie/schema-watch/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
