{
  "name": "@schema-watch/agent",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "schema-watch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle-dashboard.mjs",
    "prepack": "npm run build && npm run bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/ci/compare.test.ts"
  },
  "dependencies": {
    "@schema-watch/core": "*",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3"
  },
  "license": "Apache-2.0"
}
